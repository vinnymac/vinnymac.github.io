---
import { Image } from 'astro:assets';
import {
  displayHost,
  displayRepo,
  formatProjectDate,
  PROJECTS_LOCALE,
  projectImage,
  type Project,
} from '../lib/projects';

interface Props {
  project: Project;
  /** Cards in the first row load eagerly; everything below the fold is lazy. */
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const { data } = project;
const image = projectImage(project);
const titleId = `project-${project.id}`;

const snapshotFormat = new Intl.DateTimeFormat(PROJECTS_LOCALE, {
  year: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});

/** Where the card's single link goes, and how to describe that to every reader. */
const destination = (() => {
  if (data.status === 'active') {
    if (data.kind === 'repo') {
      const repo = displayRepo(data.url);
      return { href: data.url, hint: repo, srHint: `, source repository: ${repo}` };
    }
    const host = displayHost(data.url);
    return { href: data.url, hint: host, srHint: `, external site: ${host}` };
  }
  if (!data.archiveUrl) return undefined;
  const timestamp = /\/web\/(\d{4})(\d{2})/.exec(data.archiveUrl);
  if (!timestamp?.[1] || !timestamp[2]) {
    throw new Error(`Project "${project.id}": cannot read the snapshot date in ${data.archiveUrl}`);
  }
  const when = snapshotFormat.format(
    new Date(Date.UTC(Number(timestamp[1]), Number(timestamp[2]) - 1, 1)),
  );
  return {
    href: data.archiveUrl,
    hint: `Wayback Machine, ${when}`,
    srHint: `, archived snapshot from ${when} on the Wayback Machine (external site)`,
  };
})();

// "Live site" describes the product, not Vincent's involvement (many roles have ended).
const statusLabel =
  data.kind === 'repo' ? 'Code repo' : data.status === 'active' ? 'Live site' : 'Archived site';
---

<article class="card" data-status={data.status} data-kind={data.kind} aria-labelledby={titleId}>
  <div class="card__body">
    <h3 class="card__title" id={titleId}>
      {destination ? (
        <a class="card__link" href={destination.href}>
          {data.title}
          <span class="visually-hidden">{destination.srHint}</span>
        </a>
      ) : (
        data.title
      )}
    </h3>
    <p class="card__meta">
      <span class="card__role">{data.role}</span>
      <span class="card__dot" aria-hidden="true">·</span>
      <span class="card__dates">
        <time datetime={data.date}>{formatProjectDate(data.date)}</time>
        {data.endDate && (
          <>
            {'–'}
            <time datetime={data.endDate}>{formatProjectDate(data.endDate)}</time>
          </>
        )}
      </span>
    </p>
    <p class="card__summary">{data.summary}</p>
    {data.tags.length > 0 && (
      <ul class="card__tags" role="list" aria-label="Tags">
        {data.tags.map((tag) => (
          <li class="card__tag">{tag}</li>
        ))}
      </ul>
    )}
    <p class="card__footer">
      <span class="card__status">{statusLabel}</span>
      {destination ? (
        <span class="card__hint" aria-hidden="true">
          {destination.hint}
          <span class="card__arrow">↗</span>
        </span>
      ) : (
        <span class="card__hint">No longer online</span>
      )}
    </p>
  </div>
  <div class="card__media">
    <Image
      src={image}
      alt={data.imageAlt}
      widths={[360, 640, 960]}
      sizes="(min-width: 960px) 320px, (min-width: 685px) 420px, calc(100vw - 40px)"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="card__image"
    />
  </div>
</article>

<style lang="scss">
  @use '../styles/variables' as *;

  .card {
    --card-radius: 14px;
    --card-pad: 1.125rem;

    position: relative;
    display: flex;
    flex-direction: column;
    block-size: 100%;
    border: 1px solid var(--border-subtle);
    border-radius: var(--card-radius);
    background: var(--surface);
    container-type: inline-size;

    @media (prefers-reduced-motion: no-preference) {
      transition:
        translate 180ms cubic-bezier(0.2, 0, 0, 1),
        box-shadow 180ms ease,
        border-color 180ms ease;

      &:has(.card__link):hover,
      &:focus-within {
        translate: 0 -3px;
      }
    }

    &:has(.card__link):hover,
    &:focus-within {
      border-color: var(--text);
      box-shadow: 0 10px 24px -14px rgb(0 0 0 / 0.45);
    }

    // Body comes first in the DOM (heading before image for screen readers);
    // the image is lifted to the top visually.
    &__media {
      order: -1;
      overflow: clip;
      border-start-start-radius: calc(var(--card-radius) - 1px);
      border-start-end-radius: calc(var(--card-radius) - 1px);
      border-block-end: 1px solid var(--border-subtle);
      background: var(--bg-muted);
    }

    // Every source image (OG cards, screenshots, photos) is cropped to the
    // common 1.91:1 social-card ratio, so rows line up and nothing shifts.
    &__image {
      inline-size: 100%;
      block-size: auto;
      aspect-ratio: 40 / 21;
      object-fit: cover;
      object-position: top center;
      margin: 0;

      @media (prefers-reduced-motion: no-preference) {
        transition:
          scale 400ms cubic-bezier(0.2, 0, 0, 1),
          filter 400ms ease;
      }
    }

    &:has(.card__link):hover &__image,
    &:focus-within &__image {
      scale: 1.04;
    }

    // Archived products look like old photographs until you reach for them.
    &[data-status='archived'] &__image {
      filter: grayscale(0.7) sepia(0.25);
    }

    &[data-status='archived']:hover &__image,
    &[data-status='archived']:focus-within &__image {
      filter: none;
    }

    &__body {
      display: flex;
      flex-direction: column;
      flex: 1;
      gap: 0.5rem;
      padding: var(--card-pad);
    }

    &__title {
      margin: 0;
      font-size: 1.25rem;
      line-height: 1.3;
      text-wrap: balance;
      overflow-wrap: anywhere;
    }

    &__link {
      color: var(--text);

      &:hover,
      &:focus-visible {
        color: var(--text);
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 0.2em;
      }

      // Stretched link: the whole card is the click target, with no nested
      // interactive elements. The focus ring is drawn on this overlay so it
      // outlines the full card.
      &::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 1;
        border-radius: var(--card-radius);
      }

      &:focus-visible {
        outline: none;

        &::after {
          outline: 3px solid var(--text);
          outline-offset: 3px;
        }
      }
    }

    &__meta {
      display: flex;
      flex-wrap: wrap;
      column-gap: 0.375rem;
      margin: 0;
      font-size: $typographic-small-font-size;
      line-height: 1.4;
      font-weight: 600;
    }

    &__dates {
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    &__summary {
      margin: 0;
      font-size: 0.9375rem;
      line-height: 1.55;
      text-wrap: pretty;
    }

    &__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    &__tag {
      margin: 0;
      padding: 0.0625rem 0.5rem;
      border: 1px solid var(--border-subtle);
      border-radius: 999px;
      font-size: 0.75rem;
      line-height: 1.6;
    }

    &__footer {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      margin: auto 0 0;
      padding-block-start: 0.5rem;
      font-size: 0.8125rem;
      line-height: 1.4;
    }

    &__status {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.125rem 0.625rem;
      border-radius: 999px;
      background: var(--bg-muted);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;

      // Shape, not just color: a filled dot for active, a hollow ring for archived.
      &::before {
        content: '';
        inline-size: 0.5rem;
        block-size: 0.5rem;
        border-radius: 50%;
        background: var(--link);
      }
    }

    &[data-status='archived'] &__status::before {
      background: transparent;
      box-shadow: inset 0 0 0 1.5px currentColor;
    }

    // Code repos get a square marker, so the chip differs by shape as well as text.
    &[data-kind='repo'] &__status::before {
      border-radius: 2px;
    }

    &__hint {
      overflow-wrap: anywhere;
    }

    &__arrow {
      display: inline-block;
      margin-inline-start: 0.25em;

      @media (prefers-reduced-motion: no-preference) {
        transition: translate 180ms cubic-bezier(0.2, 0, 0, 1);
      }
    }

    &:hover &__arrow,
    &:focus-within &__arrow {
      translate: 2px -2px;
    }
  }

  @container (min-width: 22rem) {
    .card__title {
      font-size: 1.375rem;
    }
  }

  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
