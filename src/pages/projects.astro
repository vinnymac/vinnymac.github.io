---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Page from '../components/Page.astro';
import ProjectCard from '../components/ProjectCard.astro';
import siteConfig from '../site.config';
import { formatYear, getProjects, groupProjectsByYear } from '../lib/projects';
import { buildProjectsGraph } from '../lib/structured-data';

const projects = await getProjects();
const groups = groupProjectsByYear(projects);
const description = 'Some of my work over the years';
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url).toString();
// Only the first row of cards can be above the fold.
const EAGER_CARDS = 3;
let cardIndex = 0;

// Filter options. Without JavaScript the radios still filter, through CSS :has().
const total = projects.length;
const countOf = (kind: 'site' | 'repo') => projects.filter((p) => p.data.kind === kind).length;
const inProgressCount = projects.filter((p) => p.data.inProgress).length;
const filters = [
  { value: 'all', label: 'All', count: total },
  { value: 'site', label: 'Sites', count: countOf('site') },
  { value: 'repo', label: 'Repos', count: countOf('repo') },
  { value: 'progress', label: 'In progress', count: inProgressCount },
] as const;
---

<BaseLayout
  title={`Projects - ${siteConfig.title}`}
  description={description}
  structuredData={buildProjectsGraph(projects, canonicalUrl, description)}
  wide
>
  <Sidebar />
  <Page title="Projects">
    <div class="projects" data-projects>
      <p class="projects__intro">{description}</p>
      <fieldset class="projects__filter">
        <legend class="visually-hidden">Filter projects</legend>
        {filters.map(({ value, label, count }) => (
          <label class="projects__option">
            <input
              class="projects__radio"
              type="radio"
              name="type"
              id={`filter-${value}`}
              value={value}
              checked={value === 'all'}
            />
            <span class="projects__pill">
              {label}
              <span class="projects__count">{count}</span>
            </span>
          </label>
        ))}
        <p class="visually-hidden" role="status" data-filter-status>{total} projects</p>
      </fieldset>
      {groups.map(({ year, projects: yearProjects }) => (
        <section class="projects__year" aria-labelledby={`projects-${year}`}>
          <h2 class="projects__year-title" id={`projects-${year}`}>
            {formatYear(year)}
          </h2>
          <ul class="projects__grid" role="list">
            {yearProjects.map((project) => (
              <li
                class="projects__item"
                data-kind={project.data.kind}
                data-in-progress={project.data.inProgress || undefined}
              >
                <ProjectCard project={project} eager={cardIndex++ < EAGER_CARDS} />
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </Page>
</BaseLayout>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .projects {
    &__intro {
      max-inline-size: 65ch;
    }

    // Segmented control built from radios: native keyboard behavior (arrows move and
    // select), no JavaScript required, and the checked option is never color-only
    // (it is filled and its count is shown).
    &__filter {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      margin: 0 0 0.5rem;
      padding: 0;
      border: 0;
      min-inline-size: 0;
    }

    &__option {
      position: relative;
      display: inline-flex;
    }

    // Visually hidden but focusable and in the accessibility tree.
    &__radio {
      position: absolute;
      inset: 0;
      inline-size: 100%;
      block-size: 100%;
      margin: 0;
      opacity: 0;
      cursor: pointer;
    }

    &__pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      block-size: $button-height;
      padding-inline: 1rem 0.75rem;
      border: 1px solid var(--border-subtle);
      border-radius: $button-border-radius;
      background: transparent;
      color: var(--text);
      font-size: $typographic-small-font-size;
      line-height: 1;
      white-space: nowrap;

      @media (prefers-reduced-motion: no-preference) {
        transition:
          color 0.15s,
          border-color 0.15s,
          background-color 0.15s;
      }
    }

    &__count {
      min-inline-size: 1.5em;
      padding: 0.1875rem 0.375rem;
      border-radius: 999px;
      background: var(--bg-muted);
      font-size: 0.75rem;
      font-variant-numeric: tabular-nums;
      text-align: center;
    }

    &__radio:hover + &__pill {
      color: var(--link);
      border-color: var(--link);
    }

    &__radio:checked + &__pill {
      border-color: var(--text);
      background: var(--text);
      color: var(--surface);
    }

    &__radio:checked + &__pill &__count {
      background: color-mix(in srgb, var(--surface) 22%, transparent);
      color: inherit;
    }

    &__radio:focus-visible + &__pill {
      outline: 3px solid var(--text);
      outline-offset: 3px;
    }

    // Pure-CSS filtering: hide the cards that don't match, then any year left empty.
    // `kind` filters on data-kind; "In progress" cuts across kinds on data-in-progress.
    @each $filter, $match in (site: "[data-kind='site']", repo: "[data-kind='repo']", progress: '[data-in-progress]') {
      &:has(#filter-#{$filter}:checked) &__item:not(#{$match}),
      &:has(#filter-#{$filter}:checked) &__year:not(:has(&__item#{$match})) {
        display: none;
      }
    }

    &__year {
      @include margin-bottom(1.5);
    }

    // The year sits on a dashed rule that runs to the end of the row.
    &__year-title {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      @include margin-top(1);
      @include margin-bottom(0.75);
      font-variant-numeric: tabular-nums;

      &::after {
        content: '';
        flex: 1;
        border-block-start: 2px dashed var(--border-subtle);
      }
    }

    // Intrinsic grid: as many ~16rem columns as fit, never more than three,
    // so it goes 3 → 2 → 1 with the space available rather than the viewport.
    &__grid {
      --grid-gap: 1.5rem;
      --grid-min: 16rem;

      display: grid;
      grid-template-columns: repeat(
        auto-fill,
        minmax(max(min(100%, var(--grid-min)), (100% - 2 * var(--grid-gap)) / 3), 1fr)
      );
      gap: var(--grid-gap);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    &__item {
      margin: 0;
      padding: 0;
      min-inline-size: 0;
    }
  }

  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  // Progressive enhancement: cards rise into place as they scroll into view.
  // Without support (or with reduced motion) they are simply there.
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .projects__item {
        animation: projects-card-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 70%;
      }

      @keyframes projects-card-in {
        from {
          opacity: 0.15;
          translate: 0 2.5rem;
          scale: 0.97;
        }
      }
    }
  }
</style>

<script>
  // Enhancement only: announce the filtered count to screen readers (the text is
  // visually hidden, the pills already show the counts), and keep the filter in the URL
  // (?type=site | repo | progress) so it can be shared. Filtering itself is pure CSS.
  const root = document.querySelector<HTMLElement>('[data-projects]');
  const status = root?.querySelector<HTMLElement>('[data-filter-status]');
  const inputs = root?.querySelectorAll<HTMLInputElement>('input[name="type"]');

  if (root && status && inputs) {
    const total = root.querySelectorAll('.projects__item').length;
    // What each filter matches, and how the live region names it.
    const matches: Record<string, { selector: string; name: string }> = {
      site: { selector: '[data-kind="site"]', name: 'sites' },
      repo: { selector: '[data-kind="repo"]', name: 'repos' },
      progress: { selector: '[data-in-progress]', name: 'in progress' },
    };

    const apply = (value: string) => {
      if (value === 'all') {
        status.textContent = `${total} projects`;
        return;
      }
      const match = matches[value];
      if (!match) return;
      const shown = root.querySelectorAll(`.projects__item${match.selector}`).length;
      status.textContent = `${shown} ${match.name}`;
    };

    const fromUrl = new URLSearchParams(location.search).get('type');
    const initial = [...inputs].find((input) => input.value === fromUrl);
    if (initial) initial.checked = true;
    apply([...inputs].find((input) => input.checked)?.value ?? 'all');

    for (const input of inputs) {
      input.addEventListener('change', () => {
        if (!input.checked) return;
        apply(input.value);
        const url = new URL(location.href);
        if (input.value === 'all') url.searchParams.delete('type');
        else url.searchParams.set('type', input.value);
        history.replaceState(null, '', url);
      });
    }
  }
</script>
